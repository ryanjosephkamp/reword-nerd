{
  "name": "reword-nerd",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/updates.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@tesseract.js-data/eng": "1.0.0",
    "@unified-latex/unified-latex-util-parse": "1.8.4",
    "@zip.js/zip.js": "2.8.41",
    "diff": "9.0.0",
    "docx": "9.11.0",
    "dompurify": "3.4.16",
    "ignore": "5.3.2",
    "mammoth": "1.11.0",
    "marked": "18.1.0",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
